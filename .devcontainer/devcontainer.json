{
  "name": "SENPRO",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "SENPRO Streamlit",
      "onAutoForward": "openPreview"
    }
  },
  "remoteEnv": {
    "STREAMLIT_BROWSER_GATHER_USAGE_STATS": "false",
    "STREAMLIT_SERVER_HEADLESS": "true"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -r requirements.txt",
  "postAttachCommand": "echo 'Run: .venv/bin/streamlit run app.py --server.address 0.0.0.0 --server.port 8501'"
}
