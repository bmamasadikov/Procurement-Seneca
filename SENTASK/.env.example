# Database - PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/sentask"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Google Workspace Login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_WORKSPACE_ALLOWED_DOMAINS="seneca.uz"

# Google Workspace Service Account / Domain-Wide Delegation
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_WORKSPACE_DELEGATED_ADMIN_EMAIL=""
GOOGLE_WORKSPACE_CALENDAR_IMPERSONATION_EMAIL=""
GOOGLE_WORKSPACE_DEFAULT_SENDER_EMAIL="noreply@seneca.uz"

# Email (SMTP) - Nodemailer
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@seneca.uz"
SMTP_PASS="your-app-password"
SMTP_FROM="SENTASK <noreply@seneca.uz>"

# App
APP_URL="http://localhost:3000"
APP_NAME="SENTASK"
COMPANY_NAME="Seneca"

# Jobs
CRON_SECRET="replace-this-with-a-long-random-secret"

# Master accounts — comma-separated emails that have full task access regardless of DB role
MASTER_ACCOUNT_EMAILS="admin@yourdomain.com"

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=""
# Optional — can also be configured in Settings UI after deploy
TELEGRAM_GROUP_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""

# Caddy reverse proxy (production only)
DOMAIN="sentask.seneca.uz"
ACME_EMAIL="admin@seneca.uz"

# PostgreSQL (production — override defaults)
POSTGRES_PASSWORD="change-me-strong-password"
