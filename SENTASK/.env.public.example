# Domain / HTTPS
DOMAIN=sentask.example.com
ACME_EMAIL=admin@example.com
APP_URL=https://sentask.example.com
NEXTAUTH_URL=https://sentask.example.com

# App security
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
CRON_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Database
POSTGRES_DB=sentask
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Branding
APP_NAME=SENTASK
COMPANY_NAME=Seneca

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
SMTP_FROM=SENTASK <noreply@seneca.uz>

# Google OAuth (Workspace login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_ALLOWED_DOMAINS=seneca.uz

# Google Workspace service account / domain-wide delegation
# Keep private key as a single line with literal \n characters.
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_WORKSPACE_DELEGATED_ADMIN_EMAIL=
GOOGLE_WORKSPACE_CALENDAR_IMPERSONATION_EMAIL=
GOOGLE_WORKSPACE_DEFAULT_SENDER_EMAIL=
